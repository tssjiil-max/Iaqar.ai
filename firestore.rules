rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPlatformAdmin() {
      return signedIn() &&
        ((request.auth.token.platformAdmin == true) || (request.auth.token.admin == true));
    }
    function officeDoc(officeId) { return get(/databases/$(database)/documents/offices/$(officeId)); }
    function memberDoc(officeId) { return get(/databases/$(database)/documents/offices/$(officeId)/members/$(request.auth.uid)); }
    function isOfficeOwner(officeId) {
      return signedIn() && officeDoc(officeId).data.ownerUid == request.auth.uid;
    }
    function isOfficeMember(officeId) {
      return signedIn() && (isPlatformAdmin() || isOfficeOwner(officeId) ||
        (exists(/databases/$(database)/documents/offices/$(officeId)/members/$(request.auth.uid)) &&
         memberDoc(officeId).data.active != false));
    }
    function canManage(officeId) {
      return isPlatformAdmin() || isOfficeOwner(officeId) ||
        (isOfficeMember(officeId) && memberDoc(officeId).data.role in ['owner','admin','manager']);
    }
    function validNotificationPreferences() {
      return request.resource.data.notificationPreferences is map
        && request.resource.data.notificationPreferences.keys().hasOnly([
          'matches',
          'participants',
          'cooperation',
          'messages',
          'appointmentsFollowUps',
          'systemImportant'
        ])
        && request.resource.data.notificationPreferences.matches is bool
        && request.resource.data.notificationPreferences.participants is bool
        && request.resource.data.notificationPreferences.cooperation is bool
        && request.resource.data.notificationPreferences.messages is bool
        && request.resource.data.notificationPreferences.appointmentsFollowUps is bool
        && request.resource.data.notificationPreferences.systemImportant is bool;
    }
    function validOfficeProfile() {
      return request.resource.data.officeId is string
        && request.resource.data.officeName is string
        && request.resource.data.officeName.size() >= 4
        && request.resource.data.officeName.size() <= 80
        && request.resource.data.officeNameKey is string
        && request.resource.data.officeNameKey.size() >= 4
        && request.resource.data.officeNameKey.size() <= 100
        && request.resource.data.brokerName is string
        && request.resource.data.brokerName.size() > 0
        && request.resource.data.brokerName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.licenseNumber is string
        && request.resource.data.licenseNumber.size() > 0
        && request.resource.data.licenseNumber.size() <= 20
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 60
        && request.resource.data.specialties is list
        && request.resource.data.specialties.size() >= 0
        && request.resource.data.specialties.size() <= 4
        && request.resource.data.specialties.hasOnly(['sale','purchase','rent','property_management'])
        && request.resource.data.logoUrl is string
        && request.resource.data.logoUrl.size() <= 2000
        && request.resource.data.displayImageUrl is string
        && request.resource.data.displayImageUrl.size() <= 2000
        && request.resource.data.coverUrl is string
        && request.resource.data.coverUrl.size() <= 2000
        && request.resource.data.whatsappCoverUrl is string
        && request.resource.data.whatsappCoverUrl.size() <= 2000
        && request.resource.data.publicSlug is string
        && request.resource.data.publicSlug.size() <= 64
        && request.resource.data.cooperationMode in ['DISABLED','APPROVAL_REQUIRED','SMART_AUTOMATIC']
        && validNotificationPreferences();
    }

    match /offices/{officeId} {
      allow read: if isOfficeMember(officeId);
      // إنشاء المكتب وتغيير الاسم المحجوز يتمان عبر الخادم لضمان التفرد الذري.
      allow create: if false;
      allow update: if canManage(officeId)
        && validOfficeProfile()
        && request.resource.data.officeId == officeId
        && request.resource.data.officeId == resource.data.officeId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.officeName == resource.data.officeName
        && request.resource.data.officeNameKey == resource.data.officeNameKey
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'brokerName',
          'phone',
          'whatsapp',
          'licenseNumber',
          'city',
          'specialties',
          'logoUrl',
          'displayImageUrl',
          'coverUrl',
          'whatsappCoverUrl',
          'publicSlug',
          'notificationPreferences',
          'cooperationMode',
          'updatedAt'
        ]);
      allow delete: if isOfficeOwner(officeId) || isPlatformAdmin();

      match /members/{uid} {
        allow read: if isOfficeMember(officeId);
        allow write: if canManage(officeId);
      }

      match /publicIntake/{docId} {
        allow create: if request.resource.data.officeId == officeId
          && request.resource.data.kind in ['client','owner']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 80
          && request.resource.data.name.matches('.*\\s+.*')
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 9
          && request.resource.data.phone.size() <= 20
          && request.resource.data.propertyType is string
          && request.resource.data.propertyType.size() <= 40
          && request.resource.data.district is string
          && request.resource.data.district.size() <= 80
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 1000
          && request.resource.data.mediaPaths is list
          && request.resource.data.mediaPaths.size() <= 6
          && request.resource.data.imageCount is int
          && request.resource.data.imageCount >= 0
          && request.resource.data.imageCount <= 5
          && ((request.resource.data.kind == 'owner'
              && request.resource.data.imageCount >= 0
              && request.resource.data.imageCount <= 5)
            || (request.resource.data.kind == 'client'
              && request.resource.data.imageCount == 0))
          && request.resource.data.hasVideo is bool
          && request.resource.data.source in ['office_public_link','platform_public']
          && request.resource.data.status == 'new';
        allow read, update, delete: if isOfficeMember(officeId);
      }

      // رموز FCM سرية وتدار حصريًا من Cloudflare Worker بحساب الخدمة.
      match /devices/{deviceId} {
        allow read, write: if false;
      }

      match /{collectionName}/{docId} {
        allow read: if collectionName != 'devices' && isOfficeMember(officeId);
        allow create, update: if collectionName != 'devices'
          && isOfficeMember(officeId)
          && request.resource.data.officeId == officeId;
        allow delete: if collectionName != 'devices' && canManage(officeId);

        match /timeline/{eventId} {
          allow read, create: if isOfficeMember(officeId);
          allow update, delete: if canManage(officeId);
        }
      }
    }

    match /publicOffices/{officeId} {
      allow read: if true;
      allow write: if false;
    }

    match /brokerApplications/{applicationId} {
      allow create: if false;
      allow read, update, delete: if isPlatformAdmin();
    }


    match /officeNameClaims/{nameKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /officeHandles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    match /whatsapp_accounts/{phoneNumberId} {
      allow read, write: if false;
    }
    match /_system/{document=**} {
      allow read, write: if false;
    }
  }
}
