rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPlatformAdmin() {
      return signedIn() &&
        ((request.auth.token.platformAdmin == true) || (request.auth.token.admin == true));
    }
    function officeDoc(officeId) { return get(/databases/$(database)/documents/offices/$(officeId)); }
    function memberDoc(officeId) { return get(/databases/$(database)/documents/offices/$(officeId)/members/$(request.auth.uid)); }
    function isOfficeOwner(officeId) {
      return signedIn() && officeDoc(officeId).data.ownerUid == request.auth.uid;
    }
    function isOfficeMember(officeId) {
      return signedIn() && (isPlatformAdmin() || isOfficeOwner(officeId) ||
        (exists(/databases/$(database)/documents/offices/$(officeId)/members/$(request.auth.uid)) &&
         memberDoc(officeId).data.active != false));
    }
    function canManage(officeId) {
      return isPlatformAdmin() || isOfficeOwner(officeId) ||
        (isOfficeMember(officeId) && memberDoc(officeId).data.role in ['owner','admin','manager']);
    }
    function brokerUxKeysValid(map) {
      return map.keys().hasOnly([
        'ownerPrice', 'clientPrice', 'lastOffer', 'negotiationStatus', 'negotiationNote',
        'clientViewingConfirmed', 'ownerViewingConfirmed', 'viewingConfirmedAt'
      ]);
    }
    function isBrokerUxOnlyUpdate(officeId) {
      return isOfficeMember(officeId)
        && resource.data.officeId == officeId
        && request.resource.data.officeId == officeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['brokerUx', 'updatedAt'])
        && brokerUxKeysValid(request.resource.data.brokerUx);
    }
    // مجموعات لها قواعد صريحة أضيق، فتُستثنى من القاعدة العامة داخل المكتب.
    // المرحلة 8: إغلاق المجموعات الحساسة (clients/owners/deals/alerts/inbox/usage/contacts).
    function isRestrictedOfficeCollection(collectionName) {
      return collectionName in [
        'devices', 'officeSettings', 'brokerSettings', 'opportunitySources', 'opportunities',
        'sharedOpportunities', 'matches', 'operations', 'notifications', 'auditLogs', 'messages',
        'clients', 'owners', 'deals', 'alerts', 'inbox', 'usage', 'contacts', 'publicIntake', 'library',
        'activityEvents', 'adminNotes', 'importJobs', 'partySessions', 'partySessionKeys'
      ];
    }
    function validOfficeProfile() {
      return request.resource.data.officeName is string
        && request.resource.data.officeName.size() <= 80
        && request.resource.data.officeNameKey is string
        && request.resource.data.officeNameKey.size() <= 100
        && (isPlatformAdmin() || request.resource.data.officeNameKey.size() >= 4)
        && request.resource.data.specialties is list
        && request.resource.data.specialties.size() >= 0
        && request.resource.data.specialties.size() <= 4
        && request.resource.data.specialties.hasOnly(['sale','purchase','rent','property_management'])
        && validServiceNeighborhoodIdsField();
    }
    function validServiceNeighborhoodIdsField() {
      return !('serviceNeighborhoodIds' in request.resource.data)
        || (
          request.resource.data.serviceNeighborhoodIds is list
          && request.resource.data.serviceNeighborhoodIds.size() >= 1
          && request.resource.data.serviceNeighborhoodIds.size() <= 5
        );
    }

    match /offices/{officeId} {
      allow read: if isOfficeMember(officeId);
      allow create: if isPlatformAdmin() && validOfficeProfile();
      allow update: if canManage(officeId) && validOfficeProfile();
      allow delete: if isOfficeOwner(officeId) || isPlatformAdmin();

      match /members/{uid} {
        allow read: if isOfficeMember(officeId);
        allow write: if canManage(officeId);
      }

      match /publicIntake/{docId} {
        allow create: if request.resource.data.officeId == officeId
          && request.resource.data.kind in ['client','owner']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 80
          && request.resource.data.name.matches('.*\\s+.*')
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 9
          && request.resource.data.phone.size() <= 20
          && request.resource.data.propertyType is string
          && request.resource.data.propertyType.size() <= 40
          && request.resource.data.district is string
          && request.resource.data.district.size() <= 80
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 1000
          && request.resource.data.mediaPaths is list
          && request.resource.data.mediaPaths.size() <= 6
          && request.resource.data.imageCount is int
          && request.resource.data.imageCount >= 0
          && request.resource.data.imageCount <= 5
          && ((request.resource.data.kind == 'owner'
              && request.resource.data.imageCount >= 0
              && request.resource.data.imageCount <= 5)
            || (request.resource.data.kind == 'client'
              && request.resource.data.imageCount == 0))
          && request.resource.data.hasVideo is bool
          && request.resource.data.source in ['office_public_link','platform_public']
          && request.resource.data.status == 'new';
        // القراءة للأعضاء — التحديث/الحذف عبر Worker فقط (منع تزوير processed).
        allow read: if isOfficeMember(officeId);
        allow update, delete: if false;
      }

      // رموز FCM سرية وتدار حصريًا من Cloudflare Worker بحساب الخدمة.
      match /devices/{deviceId} {
        allow read, write: if false;
      }

      // إعدادات المكتب: قراءة لأعضاء المكتب، وكتابة لمن يملك إدارة المكتب فقط.
      match /officeSettings/{settingId} {
        allow read: if isOfficeMember(officeId);
        allow create, update: if canManage(officeId)
          && request.resource.data.officeId == officeId;
        allow delete: if false;
      }

      // المكتبة الخاصة بالمكتب — ملفات داخلية واتفاقيات مشتركة.
      match /library/{itemId} {
        allow read: if isOfficeMember(officeId);
        allow create: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() <= 240
          && (!("category" in request.resource.data)
            || request.resource.data.category in [
              'owner_brokerage', 'buyer_brokerage', 'tenant_brokerage',
              'broker_cooperation', 'sub_brokerage', 'sale_contract',
              'lease_contract', 'contract_addendum', 'fal_license',
              'office_document', 'office_media', 'other'
            ])
          && (!("documentTitle" in request.resource.data)
            || request.resource.data.documentTitle is string
            && request.resource.data.documentTitle.size() <= 240)
          && (!("referenceNumber" in request.resource.data)
            || request.resource.data.referenceNumber is string
            && request.resource.data.referenceNumber.size() <= 120)
          && (!("opportunityId" in request.resource.data)
            || request.resource.data.opportunityId is string
            && request.resource.data.opportunityId.size() <= 120)
          && (!("cooperationId" in request.resource.data)
            || request.resource.data.cooperationId is string
            && request.resource.data.cooperationId.size() <= 120)
          && (!("documentStatus" in request.resource.data)
            || request.resource.data.documentStatus in ['ACTIVE', 'EXPIRED', 'PENDING', 'CANCELLED']);
        allow update: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && resource.data.officeId == officeId
          && (!("category" in request.resource.data)
            || request.resource.data.category in [
              'owner_brokerage', 'buyer_brokerage', 'tenant_brokerage',
              'broker_cooperation', 'sub_brokerage', 'sale_contract',
              'lease_contract', 'contract_addendum', 'fal_license',
              'office_document', 'office_media', 'other'
            ])
          && (!("documentTitle" in request.resource.data)
            || request.resource.data.documentTitle is string
            && request.resource.data.documentTitle.size() <= 240)
          && (!("referenceNumber" in request.resource.data)
            || request.resource.data.referenceNumber is string
            && request.resource.data.referenceNumber.size() <= 120)
          && (!("opportunityId" in request.resource.data)
            || request.resource.data.opportunityId is string
            && request.resource.data.opportunityId.size() <= 120)
          && (!("cooperationId" in request.resource.data)
            || request.resource.data.cooperationId is string
            && request.resource.data.cooperationId.size() <= 120)
          && (!("documentStatus" in request.resource.data)
            || request.resource.data.documentStatus in ['ACTIVE', 'EXPIRED', 'PENDING', 'CANCELLED']);
        allow delete: if canManage(officeId)
          && resource.data.officeId == officeId;
      }

      // تفضيلات الوسيط الشخصية: لا يكتبها أحد غير صاحبها.
      match /brokerSettings/{brokerUid} {
        allow read: if isOfficeMember(officeId)
          && (brokerUid == request.auth.uid || canManage(officeId));
        allow create, update: if isOfficeMember(officeId)
          && brokerUid == request.auth.uid
          && request.resource.data.officeId == officeId
          && request.resource.data.brokerId == request.auth.uid;
        allow delete: if false;
      }

      // مصادر الإدخال الموحّد (المرحلة 2): تبقى داخل المكتب ومعرّفة بـ officeId.
      match /opportunitySources/{sourceId} {
        allow read: if isOfficeMember(officeId);
        allow create: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && request.resource.data.brokerId == request.auth.uid
          && request.resource.data.sourceType is string
          && request.resource.data.deduplicationFingerprint is string;
        allow update, delete: if canManage(officeId)
          && request.resource.data.officeId == officeId;
      }

      match /importJobs/{jobId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // الفرصة الموحّدة (المرحلة 2/3): إنشاء/تحديث لأعضاء المكتب مع حماية الملكية.
      match /opportunities/{opportunityId} {
        allow read: if isOfficeMember(officeId);
        allow create: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && request.resource.data.brokerId is string
          && request.resource.data.deduplicationFingerprint is string
          && request.resource.data.sourceType is string
          && request.resource.data.sourceReference is string;
        allow update: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && resource.data.officeId == officeId
          && request.resource.data.officeId == resource.data.officeId
          && request.resource.data.brokerId == resource.data.brokerId
          && (
            !('originatingOfficeId' in resource.data)
            || request.resource.data.originatingOfficeId == resource.data.originatingOfficeId
          )
          && (
            !('originatingBrokerId' in resource.data)
            || request.resource.data.originatingBrokerId == resource.data.originatingBrokerId
          )
          && (
            !('currentOwningOfficeId' in resource.data)
            || request.resource.data.currentOwningOfficeId == resource.data.currentOwningOfficeId
          )
          && (
            !('createdAt' in resource.data)
            || request.resource.data.createdAt == resource.data.createdAt
          )
          && (
            !('deduplicationFingerprint' in resource.data)
            || request.resource.data.deduplicationFingerprint == resource.data.deduplicationFingerprint
          );
        // الحذف الصلب ممنوع للعملاء — الحذف الآمن يتم عبر حقول lifecycle فقط.
        allow delete: if false;

        match /communications/{communicationId} {
          allow read, create: if isOfficeMember(officeId);
          allow update, delete: if canManage(officeId);
        }
      }

      match /partySessions/{sessionId} {
        allow read, write: if false;
      }
      match /partySessionKeys/{keyId} {
        allow read, write: if false;
      }

      // المطابقات (المرحلة 4): القراءة لأعضاء المكتب فقط — الكتابة عبر Worker (Admin SDK).
      match /matches/{matchId} {
        allow read: if isOfficeMember(officeId);
        allow create, delete: if false;
        allow update: if isBrokerUxOnlyUpdate(officeId);
        match /timeline/{eventId} {
          allow read: if isOfficeMember(officeId);
          allow create: if isOfficeMember(officeId)
            && request.resource.data.officeId == officeId;
          allow update, delete: if canManage(officeId);
        }
      }

      // عمليات مركز العمليات (المرحلة 5): قراءة الأعضاء — الإنشاء/الحالة عبر Worker فقط.
      match /operations/{operationId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // إشعارات داخل التطبيق (المرحلة 5): قراءة الأعضاء — حالة التسليم محمية من العميل.
      match /notifications/{notificationId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // سجل تدقيق التعاون (المرحلة 6): قراءة الأعضاء — الكتابة عبر Worker فقط.
      match /auditLogs/{auditId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // مسودات الرسائل الذكية (المرحلة 7): قراءة الأعضاء — الإنشاء/الحالة عبر Worker فقط.
      // لا يجوز للعميل تزوير SENT أو DELIVERED.
      match /messages/{messageId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // أحداث نشاط المكتب — للإدارة فقط، والكتابة عبر Worker.
      match /activityEvents/{eventId} {
        allow read: if isPlatformAdmin();
        allow create, update, delete: if false;
      }

      // ملاحظات إدارية — للإدارة فقط، والكتابة عبر Worker.
      match /adminNotes/{noteId} {
        allow read: if isPlatformAdmin();
        allow create, update, delete: if false;
      }

      // سجلات العملاء/الملاك (المرحلة 8): قراءة الأعضاء — الكتابة عبر Worker فقط.
      match /clients/{clientId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }
      match /owners/{ownerId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }

      // الصفقات الداخلية (المرحلة 8): قراءة الأعضاء — الكتابة عبر Worker فقط.
      // تحديث السعر/العمولة/الملاحظة يتم عبر POST /workflow/action.
      match /deals/{dealId} {
        allow read: if isOfficeMember(officeId);
        allow create, delete: if false;
        allow update: if isBrokerUxOnlyUpdate(officeId);
        match /timeline/{eventId} {
          allow read: if isOfficeMember(officeId);
          allow create: if isOfficeMember(officeId)
            && request.resource.data.officeId == officeId;
          allow update, delete: if canManage(officeId);
        }
      }

      // التنبيهات القديمة / الوارد / العدادات: Worker فقط.
      match /alerts/{alertId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }
      match /inbox/{inboxId} {
        allow read: if isOfficeMember(officeId);
        allow create, update, delete: if false;
      }
      match /usage/{usageId} {
        allow read, create, update, delete: if false;
      }

      // دليل جهات الاتصال: أعضاء المكتب يكتبون حقولًا محدودة مع officeId.
      match /contacts/{contactId} {
        allow read: if isOfficeMember(officeId);
        allow create, update: if isOfficeMember(officeId)
          && request.resource.data.officeId == officeId
          && contactId.matches('^[0-9]{8,15}$')
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 40
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() <= 120;
        allow delete: if canManage(officeId);
      }

      // القاعدة العامة تستثني المجموعات أعلاه: قواعد Firestore تُجمع ولا تُضيّق،
      // فالاستثناء هو الوسيلة الوحيدة لجعل القواعد الأضيق نافذة فعلًا.
      match /{collectionName}/{docId} {
        allow read: if !isRestrictedOfficeCollection(collectionName)
          && isOfficeMember(officeId);
        allow create, update: if !isRestrictedOfficeCollection(collectionName)
          && isOfficeMember(officeId)
          && request.resource.data.officeId == officeId;
        allow delete: if !isRestrictedOfficeCollection(collectionName)
          && canManage(officeId);

        match /timeline/{eventId} {
          allow read, create: if !isRestrictedOfficeCollection(collectionName)
            && isOfficeMember(officeId);
          allow update, delete: if !isRestrictedOfficeCollection(collectionName)
            && canManage(officeId);
        }
      }
    }

    match /publicOffices/{officeId} {
      allow read: if true;
      allow create, update, delete: if canManage(officeId);
    }

    match /brokerApplications/{applicationId} {
      allow create: if false;
      allow read, update, delete: if isPlatformAdmin();
    }

    match /adminAuditLogs/{auditId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }


    // سجل تفرد أسماء المكاتب على مستوى المنصة. معرّف المستند هو الاسم بعد التطبيع،
    // فيصبح التفرد خصيصة مفتاح أساسي لا نتيجة استعلام، ويمنع التسابق.
    function validOfficeNameClaim(nameKey) {
      return request.resource.data.officeId is string
        && request.resource.data.officeName is string
        && request.resource.data.officeName.size() <= 80
        && (isPlatformAdmin() || nameKey.size() >= 4)
        && (canManage(request.resource.data.officeId)
          || getAfter(/databases/$(database)/documents/offices/$(request.resource.data.officeId)).data.ownerUid == request.auth.uid);
    }
    match /officeNameClaims/{nameKey} {
      allow read: if signedIn();
      allow create: if signedIn() && validOfficeNameClaim(nameKey);
      // الشرط الإضافي يمنع مكتبًا من توجيه حجز مكتب آخر إلى نفسه واستيلائه على الاسم.
      allow update: if signedIn()
        && validOfficeNameClaim(nameKey)
        && resource.data.officeId == request.resource.data.officeId;
      allow delete: if signedIn()
        && (isPlatformAdmin() || canManage(resource.data.officeId));
    }

    // طلبات التعاون الصريحة (المرحلة 3) — لا تعاون تلقائي.
    match /cooperationRequests/{requestId} {
      allow read: if signedIn()
        && (isOfficeMember(resource.data.originatingOfficeId)
          || isOfficeMember(resource.data.targetOfficeId));
      allow create: if signedIn()
        && isOfficeMember(request.resource.data.originatingOfficeId)
        && request.resource.data.originatingBrokerId == request.auth.uid
        && request.resource.data.originatingOfficeId is string
        && request.resource.data.targetOfficeId is string
        && request.resource.data.originatingOfficeId != request.resource.data.targetOfficeId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.permissions.readOnly == true
        && request.resource.data.permissions.contactVisible == false
        && request.resource.data.permissions.ownershipModifiable == false
        && request.resource.data.permissions.canDelete == false;
      allow update: if signedIn()
        && resource.data.originatingOfficeId == request.resource.data.originatingOfficeId
        && resource.data.targetOfficeId == request.resource.data.targetOfficeId
        && (
          (
            isOfficeMember(resource.data.targetOfficeId)
            && resource.data.status == 'PENDING'
            && (request.resource.data.status == 'ACCEPTED'
              || request.resource.data.status == 'REJECTED'
              || request.resource.data.status == 'DETAILS_REQUESTED')
          )
          || (
            isOfficeMember(resource.data.originatingOfficeId)
            && (request.resource.data.status == 'REVOKED'
              || request.resource.data.status == 'ENDED')
          )
        );
      allow delete: if false;
    }

    // غرف التعاون الخاصة — للمكتبين المشاركين فقط بعد القبول.
    match /cooperationRooms/{roomId} {
      allow read: if signedIn()
        && (isOfficeMember(resource.data.originatingOfficeId)
          || isOfficeMember(resource.data.targetOfficeId));
      allow create, update, delete: if false;
    }

    // إسقاطات مشاركة الحد الأدنى للطرف المتعاون — بدون بيانات تواصل.
    // بعد الإلغاء (revokedAt) يُمنع الوصول المستقبلي (اختبار 12).
    match /offices/{officeId}/sharedOpportunities/{sharedId} {
      allow read: if isOfficeMember(officeId)
        && !('revokedAt' in resource.data && resource.data.revokedAt != null);
      allow create: if isOfficeMember(officeId)
        && request.resource.data.originatingOfficeId is string
        && request.resource.data.originatingOfficeId != officeId
        && request.resource.data.contactPhone == ''
        && request.resource.data.phone == ''
        && request.resource.data.readOnly == true;
      // Updates blocked after revocation so future access cannot be restored by clients.
      allow update: if isOfficeMember(officeId)
        && !('revokedAt' in resource.data && resource.data.revokedAt != null)
        && request.resource.data.originatingOfficeId is string
        && request.resource.data.originatingOfficeId != officeId
        && request.resource.data.contactPhone == ''
        && request.resource.data.phone == ''
        && request.resource.data.readOnly == true;
      allow delete: if canManage(officeId);
    }

    // نطاق مشاركة بنك الفرص — معطّل افتراضيًا وقابل للإلغاء.
    match /bankSharingScopes/{scopeId} {
      allow read: if signedIn()
        && (isOfficeMember(resource.data.originatingOfficeId)
          || (isOfficeMember(resource.data.targetOfficeId)
            && resource.data.status == 'ACTIVE'
            && resource.data.enabled == true
            && !('revokedAt' in resource.data && resource.data.revokedAt != null)));
      allow create: if signedIn()
        && isOfficeMember(request.resource.data.originatingOfficeId)
        && request.resource.data.originatingBrokerId == request.auth.uid
        && request.resource.data.originatingOfficeId != request.resource.data.targetOfficeId
        && request.resource.data.permissions.contactVisible == false
        && request.resource.data.permissions.readOnly == true;
      allow update: if signedIn()
        && isOfficeMember(resource.data.originatingOfficeId)
        && request.resource.data.originatingOfficeId == resource.data.originatingOfficeId
        && request.resource.data.targetOfficeId == resource.data.targetOfficeId;
      allow delete: if false;
    }

    match /whatsapp_accounts/{phoneNumberId} {
      allow read, write: if false;
    }
    match /partySessionTokens/{tokenHash} {
      allow read, write: if false;
    }
    match /_system/{document=**} {
      allow read, write: if false;
    }
  }
}
