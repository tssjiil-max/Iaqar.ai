<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>أسامة ونطّاح</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, #1a2a3a, #0d1520);
      color: #fff;
      font-family: Tahoma, Arial, sans-serif;
      padding: 1rem;
    }
    .card {
      width: min(420px, 100%);
      background: rgba(255,255,255,0.08);
      border-radius: 18px;
      padding: 1.5rem;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }
    h1 { margin: 0 0 0.5rem; font-size: 1.8rem; }
    p { margin: 0.4rem 0; line-height: 1.6; color: #d7e3f4; }
    .btn {
      display: none;
      width: 100%;
      margin-top: 1rem;
      padding: 1rem;
      border: 0;
      border-radius: 12px;
      background: #2d6a4f;
      color: #fff;
      font-size: 1.2rem;
      font-weight: bold;
    }
    .btn.show { display: block; }
    progress {
      width: 100%;
      height: 18px;
      margin: 1rem 0 0.5rem;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>أسامة ونطّاح</h1>
    <p id="msg">اضغط العب لبدء التحميل</p>
    <p id="hint">استخدم Chrome • اقلب الجوال أفقي</p>
    <progress id="bar" value="0" max="100" hidden></progress>
    <button id="play" class="btn show" type="button">▶️ العب الآن</button>
    <button id="retry" class="btn" type="button">🔄 حاول مرة ثانية</button>
  </div>
  <script>
    const playBtn = document.getElementById('play');
    const retryBtn = document.getElementById('retry');
    const bar = document.getElementById('bar');
    const msg = document.getElementById('msg');

    async function preload() {
      playBtn.classList.remove('show');
      retryBtn.classList.remove('show');
      bar.hidden = false;
      msg.textContent = 'جاري تحميل اللعبة... لا تغلق الصفحة';

      const files = ['index.js', 'index.wasm', 'index.pck'];
      let loaded = 0;
      let total = 0;

      for (const file of files) {
        const head = await fetch(file, { method: 'HEAD', cache: 'force-cache' });
        const size = Number(head.headers.get('content-length') || 0);
        total += size;
      }

      for (const file of files) {
        const res = await fetch(file, { cache: 'force-cache' });
        const reader = res.body.getReader();
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          loaded += value.byteLength;
          const pct = total > 0 ? Math.min(99, Math.round((loaded / total) * 100)) : 0;
          bar.value = pct;
          msg.textContent = 'جاري التحميل... ' + pct + '%';
        }
      }

      bar.value = 100;
      msg.textContent = 'تم! جاري فتح اللعبة...';
      setTimeout(() => { window.location.href = 'index.html'; }, 400);
    }

    playBtn.addEventListener('click', () => {
      preload().catch((err) => {
        console.error(err);
        msg.textContent = 'فشل التحميل. تأكد من Chrome والنت وحاول مرة ثانية.';
        retryBtn.classList.add('show');
      });
    });

    retryBtn.addEventListener('click', () => {
      playBtn.classList.add('show');
      preload().catch(() => {
        msg.textContent = 'ما زال في مشكلة. جرّب شبكة أقوى أو Wi-Fi.';
        retryBtn.classList.add('show');
      });
    });
  </script>
</body>
</html>
