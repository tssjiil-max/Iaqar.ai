{
  "name": "iaqar-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IAQAR.AI — intelligent operating system for real-estate offices and licensed brokers",
  "scripts": {
    "test": "npm run test:web && npm run test:worker",
    "test:web": "node --test test/*.test.mjs",
    "test:worker": "npm test --prefix worker",
    "test:matching:gate": "node --test test/matching-admission-domain.test.mjs test/matching-phase4.test.mjs test/matching-release-gate.test.mjs worker/test/match-integrity-domain.test.mjs test/operations-phase5.test.mjs",
    "test:post-match:gate": "node --test test/post-match-chain-release-gate.test.mjs test/full-transaction-chain-contract.test.mjs test/post-match-coordination.test.mjs test/match-operation-broker-sync.test.mjs",
    "test:negotiation:gate": "node --test test/negotiation-cleanup-phase4.test.mjs test/negotiation-workflow-v2.test.mjs test/negotiation-buttons-v1.test.mjs test/coordination-bundle.test.mjs test/party-session.test.mjs",
    "test:viewing:gate": "node --test test/viewing-cleanup-phase5.test.mjs test/iaqar-appointment.test.mjs test/post-match-coordination.test.mjs test/match-operation-broker-sync.test.mjs test/party-session.test.mjs",
    "test:deal:gate": "node --test test/deal-contract-cleanup-phase6.test.mjs test/full-transaction-chain-contract.test.mjs test/post-match-chain-release-gate.test.mjs test/operations-coverage-phase1.test.mjs",
    "test:cooperation:gate": "node --test test/cooperation-cleanup-phase7.test.mjs test/cooperation-phase6.test.mjs test/cooperation-workflow.test.mjs test/cooperation.test.mjs",
    "test:channels:gate": "node --test test/channels-bot-cleanup-phase8.test.mjs test/channels-whatsapp-media-static.test.mjs test/messaging-phase7.test.mjs test/integration-honesty.test.mjs test/whatsapp-handoff.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-iaqar-rules \"node --test test/emulator/firestore-rules.emulator.test.mjs\"",
    "test:phase1-security": "npm test && npm run test:rules && npm run check",
    "test:phase8": "npm test && npm run test:rules && npm run check",
    "test:phase9a": "npm test && npm run test:rules && npm run check",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:staging:safe": "bash scripts/deploy-staging-safe.sh",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "check": "node scripts/check.mjs",
    "v2:content": "node scripts/copy-content-v2.mjs",
    "cleanup:staging-opportunities": "node scripts/cleanup-staging-opportunities.mjs",
    "reset:staging-opportunities": "node scripts/reset-staging-office-opportunities.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report playwright-report"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.55.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^14.22.0",
    "jsdom": "^26.1.0"
  }
}
